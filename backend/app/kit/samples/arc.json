{
  "name": "arc",
  "blurb": "Run-in, two-period crossover, extension decision, exacerbation events",
  "file": "ARC-12_protocol_v1.4.pdf",
  "model": {
    "protocol": {
      "title": "A Randomized, Double-Blind, Placebo-Controlled, Two-Period Crossover Study of ARC-5 Inhaler in Moderate Asthma, With Open-Label Extension",
      "number": "ARC-12",
      "sponsor": "Sample Respiratory (fictional)",
      "phase": "Phase II",
      "indication": "Moderate persistent asthma",
      "version": "v1.4",
      "design": "A 14-day single-blind placebo run-in, then randomization to sequence AB or BA: two 28-day treatment periods separated by a washout. Participants who complete period 2 may enter a 48-week open-label extension."
    },
    "arms": [
      {
        "id": "AB",
        "name": "Sequence AB · ARC-5 then placebo",
        "description": ""
      },
      {
        "id": "BA",
        "name": "Sequence BA · placebo then ARC-5",
        "description": ""
      }
    ],
    "anchors": [
      {
        "id": "screening",
        "label": "Screening",
        "kind": "start"
      },
      {
        "id": "runin",
        "label": "Run-in start",
        "kind": "relative",
        "relative_to": "screening",
        "offset_days": 7,
        "set_by_visit": "run"
      },
      {
        "id": "p1",
        "label": "Period 1 start",
        "kind": "relative",
        "relative_to": "runin",
        "offset_days": 14,
        "is_day1": true,
        "set_by_visit": "p1d1"
      },
      {
        "id": "p2",
        "label": "Period 2 start",
        "kind": "relative",
        "relative_to": "p1",
        "offset_days": 42,
        "set_by_visit": "p2d1",
        "note": "28-day period plus at least 14 days washout."
      },
      {
        "id": "ole",
        "label": "Extension start",
        "kind": "relative",
        "relative_to": "p2",
        "offset_days": 28
      }
    ],
