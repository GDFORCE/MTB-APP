{
 "about": "Shared cases for the two calc v1 interpreters (backend/app/kit/calc.py and frontend/src/features/kit/calc.ts). Both test suites run every case and must get exactly 'expect' (or an error when 'error' is true).",
 "cases": [
  {"name": "arithmetic and remainder", "program": {"record": {"sum": {"op": "+", "args": [1, 2, 3]}, "mod": {"op": "%", "args": [-3, 7]}, "div": {"op": "/", "args": [7, 2]}, "floor": {"op": "floor", "args": [-1.5]}}}, "expect": {"sum": 6, "mod": 4, "div": 3.5, "floor": -2}},
  {"name": "dates", "program": {"let": {"d": {"date": "2026-02-27"}}, "in": {"record": {"plus": {"op": "add_days", "args": [{"var": "d"}, 3]}, "between": {"op": "days_between", "args": [{"date": "2026-01-01"}, {"var": "d"}]}, "weekday": {"op": "weekday", "args": [{"var": "d"}]}, "latest": {"op": "max", "args": [{"var": "d"}, {"date": "2026-03-01"}]}}}}, "expect": {"plus": "2026-03-02", "between": 57, "weekday": 5, "latest": "2026-03-01"}},
  {"name": "a missing value propagates and compares as false", "program": {"record": {"add": {"op": "add_days", "args": [null, 3]}, "lt": {"op": "<", "args": [null, 1]}, "eq": {"op": "==", "args": [null, null]}, "ne": {"op": "!=", "args": [null, false]}, "co": {"op": "coalesce", "args": [null, 5]}}}, "expect": {"add": null, "lt": false, "eq": true, "ne": true, "co": 5}},
  {"name": "if needs exactly true", "program": {"record": {"a": {"op": "if", "args": [null, 1, 2]}, "b": {"op": "if", "args": [{"op": "and", "args": [true, {"op": "not", "args": [false]}]}, 1, 2]}}}, "expect": {"a": 2, "b": 1}},
  {"name": "lists", "program": {"let": {"xs": {"map": {"fact": "visit", "id": "inj"}, "as": "o", "do": {"var": "o.n"}}}, "in": {"record": {"count": {"op": "count", "args": [{"var": "xs"}]}, "first": {"op": "first", "args": [{"var": "xs"}]}, "last": {"op": "last", "args": [{"var": "xs"}]}, "second": {"op": "nth", "args": [{"var": "xs"}, 2]}, "none": {"op": "nth", "args": [{"var": "xs"}, 9]}}}}, "facts": {"visits": {"inj": [{"n": 1}, {"n": 2}, {"n": 3}]}}, "expect": {"count": 3, "first": 1, "last": 3, "second": 2, "none": null}},
  {"name": "facts", "program": {"record": {"anchor": {"fact": "anchor", "id": "day1"}, "answer": {"fact": "answer", "id": "arm"}, "events": {"fact": "event_dates", "id": "pd"}, "today": {"fact": "today"}}}, "facts": {"anchors": {"day1": "2026-01-05"}, "answers": {"arm": "A"}, "events": {"pd": ["2026-03-01", "2026-02-01"]}, "today": "2026-04-01"}, "expect": {"anchor": "2026-01-05", "answer": "A", "events": ["2026-02-01", "2026-03-01"], "today": "2026-04-01"}},
  {"name": "text", "program": {"op": "text", "args": [{"str": "after injection "}, 4, {"str": " on "}, {"date": "2026-01-05"}, {"str": " ("}, 2.0, {"str": ")"}]}, "expect": "after injection 4 on 2026-01-05 (2)"},
  {"name": "samples after given injections", "program": {"map": {"filter": {"fact": "visit", "id": "inj"}, "as": "o", "where": {"op": "and", "args": [{"op": "!=", "args": [{"var": "o.given"}, false]}, {"op": "!=", "args": [{"var": "o.status"}, {"str": "cancelled"}]}]}}, "as": "o", "do": {"record": {"n": {"var": "o.n"}, "date": {"op": "if", "args": [{"var": "o.given"}, {"op": "add_days", "args": [{"var": "o.actual"}, 7]}, null]}, "pending": {"op": "if", "args": [{"var": "o.given"}, null, {"op": "text", "args": [{"str": "7 days after injection "}, {"var": "o.n"}, {"str": ", once given"}]}]}}}}, "facts": {"visits": {"inj": [{"n": 1, "actual": "2026-01-06", "given": true, "status": "done"}, {"n": 2, "actual": "2026-02-03", "given": false, "status": "done"}, {"n": 3, "planned": "2026-03-02", "given": null, "status": "planned"}, {"n": 4, "planned": "2026-03-30", "given": null, "status": "cancelled"}]}}, "expect": [{"n": 1, "date": "2026-01-13", "pending": null}, {"n": 3, "date": null, "pending": "7 days after injection 3, once given"}]},
  {"name": "date kind uses this", "program": {"let": {"d": {"op": "add_days", "args": [{"var": "this.base"}, 10]}}, "in": {"op": "add_days", "args": [{"var": "d"}, {"op": "%", "args": [{"op": "-", "args": [3, {"op": "weekday", "args": [{"var": "d"}]}]}, 7]}]}}, "this": {"n": 2, "date": "2026-01-19", "base": "2026-01-05", "anchor": "2026-01-05"}, "expect": "2026-01-21"},
  {"name": "division by zero is an error", "program": {"op": "/", "args": [1, 0]}, "error": true},
  {"name": "part days are an error", "program": {"op": "add_days", "args": [{"date": "2026-01-01"}, 1.5]}, "error": true},
  {"name": "ordering mixed values is an error", "program": {"op": "<", "args": [{"date": "2026-01-01"}, 3]}, "error": true}
 ]
}
