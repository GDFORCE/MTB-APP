# Copy this file to .env and fill in the values.

# ── MongoDB Atlas connection ──────────────────────────────────────────────
# Paste your Atlas connection string here (replace the whole value).
# It looks like: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites
MONGO_URL=
DB_NAME=mtb_app

# ── Auth secrets (generate long random strings — keep these private) ──────
# e.g. run: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Optional (leave blank for now) ────────────────────────────────────────
# EMAIL_API_KEY=
# PUBLIC_APP_URL=

# Google Places API (New) — used server-side for hospital address autocomplete.
# Restrict this key to Places API (New) and set quotas/billing alerts in Google Cloud.
GOOGLE_PLACES_API_KEY=
# Optional two-letter result restriction, for example: in, us, gb (blank = worldwide).
GOOGLE_PLACES_REGION=in
GOOGLE_PLACES_LANGUAGE=en
GOOGLE_PLACES_REQUESTS_PER_MINUTE=60

# ── OTP verification ──────────────────────────────────────────────────────
OTP_TTL_MIN=10

# ── DEV-ONLY testing bypass ───────────────────────────────────────────────
# Lets you test the full signup flow before real SMS/email providers are wired.
# With this ON, any channel that has NO provider configured is not actually
# sent, and the fixed code below is accepted instead. A configured channel
# (e.g. Brevo email once set) still sends REAL codes.
# ⚠️  DELETE / set to false before going to production.
DEV_OTP_MODE=true
DEV_OTP_CODE=123456

# Remote Audit module: step-up re-authentication for sensitive actions
# (final decision, geofence approval, template activation, critical override).
# Leave unset/true in any real deployment -- this requires an MFA-authenticated
# session to mint a step-up token. Set to false only for local dev/pilot use,
# where the documented fallback is a bare password re-entry.
# REMOTE_AUDIT_STEPUP_REQUIRES_MFA=true

# Remote Audit: malware scanning (ClamAV daemon). REQUIRED before any evidence
# or document can reach a reviewer. With no scanner reachable, uploads stay
# PROCESSING_BLOCKED and invisible — that is the designed behaviour, not a bug:
# an unreachable scanner is never treated as a clean result.
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# Development escape hatch for the above. Defaults to TRUE (scanning required).
# Setting it false lets uploads through WITHOUT being scanned: they are marked
# NOT_SCANNED and forced to human review, never reported clean -- but nothing
# has actually checked them. Use it to demo without standing up ClamAV; never
# in any environment holding real site data.
# REMOTE_AUDIT_REQUIRE_MALWARE_SCAN=true

# Remote Audit: PDF signature trust anchors. A directory of PEM/DER CA
# certificates, chosen per jurisdiction. With none configured, a signed PDF is
# reported PRESENT_UNVERIFIED and routed to review — never TRUSTED. There is
# deliberately no fallback to the OS trust store: "trusted" would then mean
# something different on every machine.
# REMOTE_AUDIT_TRUST_ANCHORS_DIR=/etc/mtb/remote-audit/trust-anchors
# soft-fail (default) | hard-fail | require
# REMOTE_AUDIT_SIGNATURE_REVOCATION_MODE=soft-fail

# Remote Audit: virtual visits (LiveKit). Unset means scheduling and consent
# still work and joining reports LIVEKIT_UNAVAILABLE — documents, queries,
# evidence and scoring are unaffected by video being unavailable.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Remote Audit: OpenStreetMap Overpass endpoint for real site boundaries.
# No key or account needed. Unset (or no match) falls back to a circle
# geofence, which is the common case and is handled silently.
# OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Remote Audit: vision-model extraction for equipment photos and certificates.
# Reuses the Claude/Gemini keys already configured for protocol extraction.
# Unset means extraction falls back to manual entry — never a failure.
# REMOTE_AUDIT_VISION_MODEL_ANTHROPIC=
# REMOTE_AUDIT_VISION_MODEL_GEMINI=

# Remote Audit: metric emission (structured JSON to the remote_audit.metrics
# logger). Defaults to enabled.
# REMOTE_AUDIT_METRICS_ENABLED=true

# Remote Audit: Play Integrity (Android device/app attestation).
# Full setup in docs/remote-audit/play-integrity-setup.md. This is the one
# signal a modified app build cannot forge — without it every capture is routed
# to human review rather than auto-accepted, which is safe but slower.
# The service-account key belongs in the secrets manager in production, never
# on disk, and NEVER in the mobile build: the app only produces tokens, the
# server decodes them.
# GOOGLE_PLAY_INTEGRITY_CREDENTIALS_PATH=/secure/path/play-integrity-sa.json
# GOOGLE_PLAY_INTEGRITY_PACKAGE_NAME=com.gdforce.mytrialboard
# How stale a verdict may be, in seconds (default 600). Generous enough for a
# slow upload over hospital wifi, short enough that yesterday's token is useless.
# REMOTE_AUDIT_ATTESTATION_MAX_AGE_SECONDS=600

# SMS (phone OTP) — MSG91. Needs a DLT-approved OTP template whose variable is
# the ##OTP## code. Get the AuthKey + Template ID from your MSG91 dashboard.
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=

# Email OTP (required for sponsor/CRO/SMO/site roles) via Brevo Transactional Email.
# The sender address must be verified in Brevo before live delivery.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=My Trial Board
MTB_SUPPORT_EMAIL=support@mytrialboard.app

# ── File storage ──────────────────────────────────────────────────────────
# Backend for uploaded files: `local` (disk, default → backend/uploads/) or `s3`.
STORAGE_BACKEND=local
# Only needed when STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET=

# Protocol extraction provider: openrouter, gemini, claude, or ollama (local testing).
PROTOCOL_EXTRACTION_PROVIDER=gemini
# Add credentials for the providers you want available.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional provider-specific model overrides.
# OPENROUTER_PROTOCOL_EXTRACTION_MODEL=~deepseek/deepseek-v4-flash-latest
# OPENROUTER_PDF_ENGINE=cloudflare-ai
# GEMINI_PROTOCOL_EXTRACTION_MODEL=gemini-3.6-flash
# Maximum evidence-based repair passes after the audit (0-3).
PROTOCOL_EXTRACTION_MAX_REFINEMENTS=2
# Minimum accuracy/evidence-confidence (0-1) required to mark a schedule
# "verified" instead of "needs_review", and to accept an evidence citation.
# This is the model's OWN self-reported score, not a computed/verified value,
# so treat it as a review-priority knob rather than ground truth. Lower it to
# reduce refine-loop retries (fewer Gemini calls, fewer chances of a hard
# JSON-parse failure) and see more full drafts marked verified; raise it to
# flag more for manual review. Was hardcoded to 0.95.
PROTOCOL_EXTRACTION_MIN_CONFIDENCE=0.75
# A single extraction is 7-13 sequential Gemini calls (classify, discover,
# timing, visit_evidence, synthesize, confirm, audit, plus up to 2 more
# refine/confirm/audit rounds). Instead of re-attaching the full protocol PDF
# on every call, it's uploaded once as a Gemini context cache and every stage
# call references it — the dominant lever on per-protocol API cost for large
# PDFs. Purely a cost optimization: any failure to create/use the cache
# (below the provider's minimum size, quota, expiry mid-pipeline) silently
# falls back to attaching the PDF directly, exactly as before this existed.
# Set to 0/false to disable and always attach the PDF directly.
# PROTOCOL_EXTRACTION_PDF_CACHE=1
# How long the PDF cache lives server-side. Must comfortably exceed a single
# extraction's wall-clock time (observed up to ~9 minutes for a 100-page
# protocol with refinement rounds); default is generous on purpose.
# PROTOCOL_EXTRACTION_CACHE_TTL_SECONDS=1800
# CLAUDE_PROTOCOL_EXTRACTION_MODEL=claude-opus-5
# Local Ollama (no API key; PDF text never leaves this computer).
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_PROTOCOL_EXTRACTION_MODEL=qwen3-vl:4b-instruct-q4_K_M
# OLLAMA_PDF_BATCH_PAGES=2
# OLLAMA_EXTRACTION_CACHE_DIR=D:\OllamaExtractionCache

# Optional: private directory for the deterministic protocol page-text index.
# Cached page text is protocol content — apply the same retention/deletion
# policy as the source PDF. Unset means the index is rebuilt per request.
# PROTOCOL_PAGE_INDEX_CACHE_DIR=D:\ProtocolPageIndexCache
# Universal Clinical Trial Schedule Engine (PostgreSQL; required by /api/uctsm)
UCTSM_DATABASE_URL=postgresql+psycopg://mtb:change-me@localhost:5432/mtb
# "anthropic" (default, needs ANTHROPIC_API_KEY) or "gemini" (needs GEMINI_API_KEY).
UCTSM_EXTRACTION_PROVIDER=
# Keep category as the default until paired real-protocol evaluation passes.
# source_first enables page reconstruction, source reconciliation and coverage auditing.
UCTSM_EXTRACTION_PIPELINE=category
UCTSM_EXTRACTION_MODEL=
UCTSM_EXTRACTION_MODEL_VERSION=
UCTSM_PROMPT_VERSION=uctsm-extractor.v1
# Enable only after the documented tenant/trial cutover; rejects legacy schedule authoring APIs.
UCTSM_AUTHORITATIVE=false
UCTSM_DEMO_MODE=false
