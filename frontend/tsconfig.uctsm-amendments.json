{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "expo-env.d.ts",
    "app/(app)/clinical/amendment-review.tsx",
    "app/(app)/clinical/plane-schedule.tsx",
    "src/features/uctsm/amendments.ts",
    "src/features/uctsm/amendmentController.ts",
    "src/features/uctsm/PatientAmendmentPanel.tsx",
    "src/features/uctsm/AmendmentReviewScreen.tsx",
    "src/features/uctsm/PlaneScheduleScreen.tsx",
    "tests/uctsm-amendments.test.ts",
    "tests/uctsm-manual-rules.test.ts",
    "tests/uctsm-conflicts.test.ts",
    "src/features/uctsm/ConflictPanel.tsx",
    "tests/uctsm-required-inputs.test.ts",
    "src/features/uctsm/RequiredInputsPanel.tsx",
    "src/features/uctsm/EnrolmentInputsFields.tsx",
    "tests/uctsm-operations.test.ts",
