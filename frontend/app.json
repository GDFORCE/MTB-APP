{
  "expo": {
    "name": "My Trial Board",
    "slug": "my-trial-board",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mtb-icon.png",
    "scheme": "mytrialboard",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/mtb-adaptive-icon.png",
        "backgroundColor": "#FBF2E8"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/mtb-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/mtb-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBF2E8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
