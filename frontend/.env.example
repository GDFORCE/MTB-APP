# Copy this file to .env and fill in the value.
#
# URL where the backend (FastAPI) is running.
# Set to the PC's LAN IP so a physical phone on Expo Go can reach the backend.
# Find the IP with `ipconfig` (Windows) or `ifconfig` (Mac/Linux).
# (For web preview on the same PC, http://localhost:8000 also works.)
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.10:8000
